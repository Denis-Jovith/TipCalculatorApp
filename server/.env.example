PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (create a free cluster at https://www.mongodb.com/cloud/atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Long random string used to sign admin JWTs
JWT_SECRET=change-this-to-a-long-random-secret

# Seeded admin account (created the first time `npm run seed` runs)
ADMIN_NAME=Denis Jovitus Buberwa
ADMIN_EMAIL=denisjovitusbuberwa@gmail.com
ADMIN_PASSWORD=change-this-before-seeding

# Comma-separated list of origins allowed to call the API
CLIENT_URL=http://localhost:5173

# Optional: SMTP settings so the contact form can email you directly, and so admin user
# invites / password resets are actually delivered. If left blank: contact messages are
# still saved to the admin inbox, and invite/reset links are shown directly in the admin UI
# instead of being emailed (fine for local dev, set this in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=denisjovitusbuberwa@gmail.com
